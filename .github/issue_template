name: Solicitud de despliegue
description: Solicita desplegar un módulo de Terraform
title: "[deploy] "
labels: ["deployment-request"]

body:
  - type: dropdown
    id: cloud
    attributes:
      label: Nube
      options:
        - aws
        - azure
        - gcp
    validations:
      required: true

  - type: dropdown
    id: environment
    attributes:
      label: Ambiente
      options:
        - dev
        - qa
        - prod
    validations:
      required: true

  - type: dropdown
    id: module
    attributes:
      label: Módulo
      options:
        - network
        - aks
        - storage
    validations:
      required: true

  - type: input
    id: region
    attributes:
      label: Región
      placeholder: "Por ejemplo: eastus"
    validations:
      required: true
